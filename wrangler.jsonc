// Cloudflare Workers config – serves the static site in ./public (no build step).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-23--maxemet",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    // Unknown URLs get public/404.html with a real 404 status
    "not_found_handling": "404-page"
  }
}
